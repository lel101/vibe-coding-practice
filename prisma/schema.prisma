// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Admin
}

enum PaymentMethod {
  Cash
  Bank_Transfer @map("Bank Transfer")
  Credit_Card   @map("Credit Card")
  Other
}

enum ExpenseCategory {
  Rent
  Electricity
  Salary
  Transportation
  Miscellaneous
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String
  role      Role     @default(Admin)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  products    Product[]

  @@map("categories")
}

model Product {
  id           String         @id @default(uuid())
  SKU          String         @unique
  name         String
  categoryId   String         @map("category_id")
  category     Category       @relation(fields: [categoryId], references: [id])
  costPrice    Decimal        @map("cost_price") @db.Decimal(12, 2)
  sellingPrice Decimal        @map("selling_price") @db.Decimal(12, 2)
  currentStock Int            @map("current_stock")
  minimumStock Int            @map("minimum_stock")
  unit         String
  status       String         @default("Active") // Active, Inactive
  archived     Boolean        @default(false)
  createdAt    DateTime       @default(now()) @map("created_at")
  purchaseItems PurchaseItem[]
  saleItems    SaleItem[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model Supplier {
  id            String     @id @default(uuid())
  name          String
  contactPerson String     @map("contact_person")
  phone         String
  email         String
  address       String
  createdAt     DateTime   @default(now()) @map("created_at")
  purchases     Purchase[]

  @@map("suppliers")
}

model Purchase {
  id           String         @id @default(uuid())
  purchaseDate DateTime       @map("purchase_date")
  supplierId   String         @map("supplier_id")
  supplier     Supplier       @relation(fields: [supplierId], references: [id])
  notes        String?
  totalAmount  Decimal        @map("total_amount") @db.Decimal(12, 2)
  createdAt    DateTime       @default(now()) @map("created_at")
  items        PurchaseItem[]

  @@index([supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String   @map("purchase_id")
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  costPrice  Decimal  @map("cost_price") @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model Sale {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("invoice_number")
  date          DateTime
  customer      String?
  paymentMethod PaymentMethod @default(Cash) @map("payment_method")
  discount      Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  cogs          Decimal       @db.Decimal(12, 2)
  grossProfit   Decimal       @map("gross_profit") @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  items         SaleItem[]

  @@index([invoiceNumber])
  @@map("sales")
}

model SaleItem {
  id           String   @id @default(uuid())
  saleId       String   @map("sale_id")
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String   @map("product_id")
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Int
  sellingPrice Decimal  @map("selling_price") @db.Decimal(12, 2)
  costPrice    Decimal  @map("cost_price") @db.Decimal(12, 2) // Saved COGS

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Expense {
  id          String          @id @default(uuid())
  date        DateTime
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(12, 2)
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([category])
  @@index([date])
  @@map("expenses")
}

model Investor {
  id                     String                   @id @default(uuid())
  name                   String
  investmentAmount       Decimal                  @map("investment_amount") @db.Decimal(12, 2)
  profitSharePercentage  Decimal                  @map("profit_share_percentage") @db.Decimal(5, 2)
  createdAt              DateTime                 @default(now()) @map("created_at")
  profitDistributionItems ProfitDistributionItem[]

  @@map("investors")
}

model ProfitDistribution {
  id                String                   @id @default(uuid())
  month             String                   @unique // e.g., "2026-06"
  grossProfit       Decimal                  @map("gross_profit") @db.Decimal(12, 2)
  expenses          Decimal                  @db.Decimal(12, 2)
  netProfit         Decimal                  @map("net_profit") @db.Decimal(12, 2)
  distributedAmount Decimal                  @map("distributed_amount") @db.Decimal(12, 2)
  createdAt         DateTime                 @default(now()) @map("created_at")
  items             ProfitDistributionItem[]

  @@index([month])
  @@map("profit_distributions")
}

model ProfitDistributionItem {
  id             String             @id @default(uuid())
  distributionId String             @map("distribution_id")
  distribution   ProfitDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  investorId     String             @map("investor_id")
  investor       Investor           @relation(fields: [investorId], references: [id])
  sharePercentage Decimal            @map("share_percentage") @db.Decimal(5, 2)
  profitAmount   Decimal            @map("profit_amount") @db.Decimal(12, 2)

  @@index([distributionId])
  @@index([investorId])
  @@map("profit_distribution_items")
}
